; Godot Game Feel Lab
;
; Open this folder with Godot 4 (project.godot is the project file), press F5, and
; swing at the enemy while you drag the sliders.
;
; Written for Godot 4.7. Nothing here uses a 4.7-only API, so it should open in
; 4.3 and up; if your editor asks to convert the project, say no and check the
; version first.

config_version=5

[application]

config/name="Godot Game Feel Lab"
config/description="A one-room lab for knockback, recovery and hit-stop. From codingquests.io"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

; The three tunables and the hit-stop clock, in one place every script can reach.
GameFeel="*res://scripts/game_feel.gd"

[display]

; The room is 640x360. The window is twice that so the whole lab panel fits
; beside it, and the camera's 2x zoom (scenes/main.tscn) keeps the room filling it.
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

